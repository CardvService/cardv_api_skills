{
  "info": {
    "name": "CardV Merchant API",
    "description": "Signed requests to the CardV merchant API. Set baseUrl, keyId and signingSecret in the collection variables. Docs: https://cardv.net/developers/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Signs every request: X-Key-Id + X-Timestamp + X-Nonce + X-Signature.",
          "// Set keyId and signingSecret in the collection variables (keep the secret in 'Current value' only).",
          "const secret = pm.variables.get('signingSecret');",
          "const keyId = pm.variables.get('keyId');",
          "if (!secret || !keyId) { throw new Error('Set keyId and signingSecret in the collection variables.'); }",
          "const method = pm.request.method.toUpperCase();",
          "let path = pm.request.url.getPathWithQuery();",
          "pm.request.url.variables.each((v) => { path = path.replace(':' + v.key, encodeURIComponent(pm.variables.replaceIn(v.value || ''))); });",
          "path = pm.variables.replaceIn(path);",
          "const body = pm.request.body && pm.request.body.mode === 'raw' ? pm.variables.replaceIn(pm.request.body.raw || '') : '';",
          "if (body) { pm.request.body.update(body); }",
          "const ts = Math.floor(Date.now() / 1000).toString();",
          "const nonce = CryptoJS.lib.WordArray.random(16).toString(CryptoJS.enc.Hex);",
          "const bodyHash = CryptoJS.SHA256(CryptoJS.enc.Utf8.parse(body)).toString(CryptoJS.enc.Hex);",
          "const text = [method, path, ts, nonce, bodyHash].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(text, secret).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-Key-Id', value: keyId });",
          "pm.request.headers.upsert({ key: 'X-Timestamp', value: ts });",
          "pm.request.headers.upsert({ key: 'X-Nonce', value: nonce });",
          "pm.request.headers.upsert({ key: 'X-Signature', value: signature });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sandbox.cardv.net"
    },
    {
      "key": "keyId",
      "value": "ck_test_replace_me"
    },
    {
      "key": "signingSecret",
      "value": ""
    }
  ],
